# =============================================================================
# mcp_kitsune - combined web-research stack configuration
# Copy to .env and edit:   cp .env.example .env
# =============================================================================

# Host-side ports (container ports are fixed in docker-compose.yml)
CAMOFOX_HOST_PORT=8091    # -> camofox browser REST API (container 9377)
SEARXNG_HOST_PORT=8092    # -> SearXNG metasearch (container 8080)
MCP_HOST_PORT=8093        # -> kitsune MCP extract tools (container 8095)
DOCS_HOST_PORT=8094       # -> docs-mcp-server MCP docs tools + admin (container 6280)

# Docs auto-index seed set (one-shot on fresh build; only when the store is
# empty). Comma-separated "name=url" pairs. Leave empty for defaults:
#   js=MDN JS reference, ts=TypeScript handbook, node=Node API, python=Python 3
DOCS_SEED_LIBRARIES=
# Seed crawl tuning (lean defaults: ~100 pages/lib, fetch mode = no browser).
DOCS_SEED_MAX_PAGES=100
DOCS_SEED_MAX_DEPTH=4
DOCS_SEED_MAX_CONCURRENCY=4
DOCS_SEED_SCRAPE_MODE=fetch

# IP the host ports bind to.
#   127.0.0.1  = localhost only (safe default, nothing on the network can reach it)
#   0.0.0.0    = all interfaces (reachable from LAN/internet if firewall allows)
#   <LAN IP>   = bind to one specific interface (e.g. 192.168.1.50)
# Choose 0.0.0.0 (or a LAN IP) ONLY if you want other machines to reach the
# MCP endpoint / browser / search API. Understand the security tradeoff first.
BIND_IP=127.0.0.1

# Camoufox browser version (used as a build arg in camofox/Dockerfile)
CAMOUFOX_VERSION=135.0.1
CAMOUFOX_RELEASE=beta.24

# SearXNG image tag. Leave as latest for rolling updates, or pin a dated tag
# like 2026.7.31-6bfd82705 for reproducibility.
SEARXNG_VERSION=latest

# Optional: API key for camofox cookie/session import (off by default).
# Leave empty to keep it disabled.
CAMOFOX_API_KEY=

# Optional: local semantic search for the docs service (self-hosted, no OpenAI).
# Default: NO embedding model (pure full-text search). To enable, run an Ollama
# container and set the embedding model + its host. The docs compose service
# passes these through as DOCS_MCP_SERVER__APP__EMBEDDING_MODEL / OLLAMA_HOST.
#DOCS_EMBEDDING_MODEL=ollama:nomic-embed-text
#OLLAMA_HOST=http://ollama:11434