# kitsune compose environment (copy to .env and adjust)
# Camoufox REST API endpoint. In the compose stack this is overridden to the
# bundled camofox via Docker DNS (http://camofox:9377), so this value only
# matters for standalone runs. Default = camofox on this machine's localhost.
CAMOUFOX_BASE_URL=http://localhost:8091

# Optional: override the Camoufox session identity used by this MCP server.
CAMOUFOX_USER_ID=hermes-agent
CAMOUFOX_SESSION_KEY=kitsune

# httpx timeout (seconds) for calls to Camoufox (page loads can be slow).
CAMOUFOX_HTTP_TIMEOUT=90
